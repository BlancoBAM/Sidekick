# Optional: run Sidekick as a user service.
#   mkdir -p ~/.config/systemd/user && cp scripts/sidekick.service ~/.config/systemd/user/
#   edit WorkingDirectory below, then:
#   systemctl --user daemon-reload && systemctl --user enable --now sidekick
#   journalctl --user -u sidekick -f
[Unit]
Description=Sidekick quiz helper
After=network.target

[Service]
WorkingDirectory=%h/sidekick
ExecStart=%h/sidekick/.venv/bin/python server.py
Restart=on-failure
RestartSec=3
Nice=5

[Install]
WantedBy=default.target
