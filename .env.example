# Copy to .env and fill in. NEVER commit .env (it is in .gitignore).
# Entries in models.json whose ${VARS} or key are empty are skipped automatically.
# Run `python doctor.py` to see which entries are active and why others are skipped.

# ---- Server -------------------------------------------------------------
SIDEKICK_HOST=127.0.0.1
SIDEKICK_PORT=8765
# Where per-video transcripts are written (point at an rclone-synced dir if you like)
# SIDEKICK_TRANSCRIPTS=~/Sidekick/transcripts
# Send screenshots to vision-capable models (1 = yes). Page text from the extension is preferred.
SIDEKICK_IMAGES=0

# ---- Server-side transcription (CPU) --------------------------------------
SIDEKICK_WHISPER=base.en        # tiny.en | base.en | small.en
SIDEKICK_THREADS=2
# Browser-side Whisper model (WebGPU). Also valid: onnx-community/whisper-tiny.en, whisper-small.en
# SIDEKICK_BROWSER_WHISPER=onnx-community/whisper-base.en

# ---- Router-first chain (first entry in models.json that works wins) ----------
# 1) OmniRoute: self-hosted gateway, `npm i -g omniroute`, then `omniroute` -> http://localhost:20128/v1
#    OMNIROUTE_MODEL = the model or combo NAME exactly as shown in the OmniRoute dashboard.
OMNIROUTE_BASE_URL=http://localhost:20128/v1
OMNIROUTE_MODEL=
OMNIROUTE_API_KEY=

# 2) Direct free-tier providers (all optional). Model IDs: copy EXACTLY from each provider's model list.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
GROQ_API_KEY=
GROQ_MODEL=
CEREBRAS_API_KEY=
CEREBRAS_MODEL=
MISTRAL_API_KEY=
MISTRAL_MODEL=

# 3) Optional MiniCPM-o official API (set "enabled": true in models.json to use)
MINICPM_API_KEY=

# 4) Fully local fallback (text only): e.g. OLLAMA_MODEL=qwen3:4b  (run `ollama pull qwen3:4b`)
OLLAMA_MODEL=

# 5) Lemonade local server (http://127.0.0.1:13305/v1): load a model with `lemonade server load <model>`,
#    then set LEMONADE_MODEL to the exact ID lemonade reports.
LEMONADE_MODEL=
